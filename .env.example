# ============================================================================
# CBMS Web-GIS System - Environment Configuration Example
# Copy this file to `.env` in root or `apps/server/.env` and `apps/web/.env`
# ============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL + PostGIS Database Configuration ---
DATABASE_URL=postgresql://cbms_user:cbms_password@localhost:5432/cbms_gis_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cbms_gis_db
DB_USER=cbms_user
DB_PASSWORD=cbms_password
DB_POOL_MAX=20

# --- JWT Authentication & RBAC ---
JWT_SECRET=replace-with-a-strong-256-bit-secret-key
JWT_EXPIRES_IN=8h

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_MAP_LNG=125.5825
VITE_DEFAULT_MAP_LAT=10.0115
VITE_DEFAULT_MAP_ZOOM=13.1
VITE_CARTO_RASTER_API_KEY=
VITE_CARTO_VECTOR_API_KEY=
