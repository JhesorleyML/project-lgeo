{
  "name": "@cbms/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/modules/etl/__tests__/cbms-etl.test.ts src/modules/reports/__tests__/cbms-reports.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:import-boundaries": "tsx src/db/import-boundaries.ts",
    "db:seed-households": "tsx src/db/seed-sample-households.ts"
  },
  "dependencies": {
    "@cbms/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^3.4.0",
    "express": "^4.21.1",
    "fast-csv": "^5.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.8",
    "maplibre-gl": "6.17.0",
    "multer": "2.5.0",
    "pg": "^8.13.1",
    "vite": "8.3.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
